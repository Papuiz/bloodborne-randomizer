<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BbRando.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SoulsFormats (JKAnderson) copiado do pacote do mod original; netstandard2.1, roda em Linux e Windows. -->
    <Reference Include="SoulsFormats">
      <HintPath>..\..\lib\SoulsFormats.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Ajustes do mod original guardados como dados (gerado por "BbRando.Cli export-patches"). -->
    <EmbeddedResource Include="Data\modpatches.json" LogicalName="BbRando.Core.Data.modpatches.json" />
  </ItemGroup>

</Project>
